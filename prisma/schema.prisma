generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Address {
  id         Int     @id @default(autoincrement())
  street     String?
  city       String?
  province   String?
  country    String?
  postalCode String?
  unitNumber String?
  users      User[]
}

model Bill {
  id          Int        @id @default(autoincrement())
  userId      Int
  billName    String
  totalAmount Decimal    @db.Decimal(10, 2)
  dueDate     DateTime   @db.Date
  status      BillStatus @default(UNPAID)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  billSharing   BillSharing[]
  billReminders BillReminder[]

  @@index([dueDate, status])
}

model BillReminder {
  id           Int            @id @default(autoincrement())
  billId       Int
  reminderDate DateTime
  isSent       Boolean        @default(false)
  method       ReminderMethod @default(NOTIFICATION)
  createdAt    DateTime       @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, reminderDate])
}

model BillSharing {
  id          Int       @id @default(autoincrement())
  billId      Int
  userId      Int
  shareAmount Decimal   @db.Decimal(10, 2)
  isPaid     Boolean   @default(false)
  paidAt      DateTime?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([billId, userId])
  @@index([userId])
}

model Budget {
  id          Int              @id @default(autoincrement())
  userId      Int
  budgetName  String
  totalAmount Decimal          @db.Decimal(10, 2)
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  category    ExpenseCategory?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model calendar {
  id          Int                   @id @default(autoincrement())
  user_id     Int
  start_at    DateTime?             @db.Timestamptz(6)
  end_at      DateTime?             @db.Timestamptz(6)
  all_day     Boolean               @default(false)
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @default(now()) @db.Timestamptz(6)
  source_type calendar_source_type?
  source_id   Int?
  users       users                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([source_type, source_id], map: "idx_calendar_source")
  @@index([user_id], map: "idx_calendar_user_id")
}

model ChoreAssignment {
  id          Int         @id @default(autoincrement())
  userId      Int
  choreName   String
  description String?
  dueDate     DateTime
  status      ChoreStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

model class_schedules {
  id            Int         @id @default(autoincrement())
  user_id       Int
  meal_plan_id  Int?
  class_name    String?
  class_date    DateTime?   @db.Date
  start_time    DateTime?   @db.Time(6)
  end_time      DateTime?   @db.Time(6)
  class_section String?
  class_code    String?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  meal_plans    meal_plans? @relation(fields: [meal_plan_id], references: [id], onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Expense {
  id          Int              @id @default(autoincrement())
  userId      Int
  description String
  amount      Decimal          @db.Decimal(10, 2)
  category    ExpenseCategory?
  expenseDate DateTime         @db.Date
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expenseDate])
}

model Ingredient {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  dietaryRestriction  DietaryRestriction?
  mealItemIngredients MealItemIngredient[]
}

model MealItem {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  category            MealType?
  createdAt           DateTime             @default(now())
  mealPlans           MealPlan[]
  mealItemIngredients MealItemIngredient[]
}

model MealItemIngredient {
  id           Int     @id @default(autoincrement())
  mealItemId   Int
  ingredientId Int

  mealItem   MealItem   @relation(fields: [mealItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([mealItemId, ingredientId])
}

model MealPlan {
  id         Int      @id @default(autoincrement())
  userId     Int
  mealItemId Int
  mealDate   DateTime @db.Date
  mealType   MealType
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItem MealItem @relation(fields: [mealItemId], references: [id])

  @@index([userId, mealDate])
}

model maintenance_requests {
  id          Int      @id @default(autoincrement())
  user_id     Int
  title       String?
  description String?
  status      String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_maintenance_requests_user_id")
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  addressId    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  address             Address?             @relation(fields: [addressId], references: [id])
  mealPlans           MealPlan[]
  choreAssignments    ChoreAssignment[]
  budgets             Budget[]
  expenses            Expense[]
  bills               Bill[]
  billSharing         BillSharing[]
  schedules           Schedule[]
  maintenanceRequests MaintenanceRequest[]

  @@index([email])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model work_shifts {
  id         Int       @id @default(autoincrement())
  job_name   String?
  date_start DateTime? @db.Timestamptz(6)
  date_end   DateTime? @db.Timestamptz(6)
  users      users[]
}

//Enums
enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ReminderMethod {
  EMAIL
  NOTIFICATION
}

enum ScheduleType {
  WORK
  CLASS
  PERSONAL
}

enum DietaryRestriction {
  GLUTEN_FREE
  DAIRY_FREE
  VEGETARIAN
  NUT_FREE
  HALAL
  KOSHER
}

enum ExpenseCategory {
  FOOD
  UTILITIES
  ENTERTAINMENT
  SUPPLIES
  TRANSPORTATION
  EDUCATION
  HEALTHCARE
  OTHER
}

enum ChoreStatus {
  PENDING
  COMPLETED
  OVERDUE
}