generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Address {
  id         Int     @id @default(autoincrement())
  street     String?
  city       String?
  province   String?
  country    String?
  postalCode String? @map("postal_code")
  unitNumber String? @map("unit_number")
  users      User[]

  @@map("addresses")
}

model Bill {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  billName    String     @map("title")
  totalAmount Decimal    @map("amount") @db.Decimal(10, 2)
  dueDate     DateTime   @map("due_date") @db.Date
  status      BillStatus @default(UNPAID)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  billSharing   BillSharing[]
  billReminders BillReminder[]

  @@index([dueDate, status])
  @@map("bills")
}

model BillReminder {
  id           Int            @id @default(autoincrement())
  billId       Int            @map("bill_id")
  reminderDate DateTime       @map("reminder_date")
  isSent       Boolean        @default(false) @map("is_sent")
  method       ReminderMethod @default(NOTIFICATION)
  createdAt    DateTime       @default(now()) @map("created_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, reminderDate])
  @@map("bill_reminders")
}

model BillSharing {
  id          Int       @id @default(autoincrement())
  billId      Int       @map("bill_id")
  userId      Int       @map("user_id")
  shareAmount Decimal   @map("share_amount") @db.Decimal(10, 2)
  hasPaid     Boolean   @default(false) @map("has_paid")
  paidAt      DateTime? @map("paid_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([billId, userId])
  @@index([userId])
  @@map("bill_sharing")
}

model Budget {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  budgetName  String           @map("budget_name")
  totalAmount Decimal          @map("total_amount") @db.Decimal(10, 2)
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime         @map("end_date") @db.Date
  category    ExpenseCategory?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("budgets")
}

model Chore {
  id          Int         @id @default(autoincrement())
  choreName   String      @map("chore_name")
  description String?
  dueDate     DateTime    @map("due_date")
  status      ChoreStatus @default(PENDING)
  completedByUserId Int?  @map("completed_by_user_id")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")

  completedByUser  User?  @relation(fields: [completedByUserId], references: [id])
  choreAssignments ChoreAssignment[]

  @@map("chores")
}

model ChoreAssignment {
  id          Int         @id @default(autoincrement())
  choreId     Int         @map("chore_id")
  userId      Int         @map("user_id")

  chore       Chore       @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([choreId, userId])
  @@map("chore_assignments")
}

model Expense {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  description String
  amount      Decimal          @db.Decimal(10, 2)
  category    ExpenseCategory?
  expenseDate DateTime         @map("expense_date") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expenseDate])
  @@map("expenses")
}

model Ingredient {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique @map("ingredient_name")
  dietaryRestriction  DietaryRestriction?  @map("dietary_restriction")
  mealItemIngredients MealItemIngredient[]

  @@map("ingredients")
}

model MealItem {
  id                  Int                  @id @default(autoincrement())
  name                String               @map("meal_name")
  description         String?
  category            MealType?
  createdAt           DateTime             @default(now()) @map("created_at")
  mealPlanTemplates   MealPlanTemplate[]
  mealItemIngredients MealItemIngredient[]

  @@map("meal_items")
}

model MealItemIngredient {
  id           Int @id @default(autoincrement())
  mealItemId   Int @map("meal_item_id")
  ingredientId Int @map("ingredient_id")

  mealItem   MealItem   @relation(fields: [mealItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([mealItemId, ingredientId])
  @@map("meal_item_ingredients")
}

model MealPlanType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  mealPlanTemplates MealPlanTemplate[]
  userMealPlans     UserMealPlan[]

  @@map("meal_plan_types")
}

model MealPlanTemplate {
  id             Int      @id @default(autoincrement())
  mealPlanTypeId Int      @map("meal_plan_type_id")
  dayOfWeek      Weekday
  mealType       MealType
  mealItemId     Int      @map("meal_item_id")

  mealPlanType MealPlanType @relation(fields: [mealPlanTypeId], references: [id], onDelete: Cascade)
  mealItem     MealItem     @relation(fields: [mealItemId], references: [id])

  @@unique([mealPlanTypeId, dayOfWeek, mealType])
  @@map("meal_plan_templates")
}

model UserMealPlan {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  mealPlanTypeId Int      @map("meal_plan_type_id")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanType MealPlanType @relation(fields: [mealPlanTypeId], references: [id], onDelete: Cascade)

  @@index([userId, startDate, endDate])
  @@map("user_meal_plans")
}

model Schedule {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  title       String
  type        ScheduleType
  description String?
  startTime   DateTime     @map("start_time")
  endTime     DateTime     @map("end_time")
  location    String?

  // Fields are for Optional Classes
  courseCode String? @map("course_code")
  section    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime])
  @@map("schedules")
}

model MaintenanceRequest {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  title       String
  description String
  urgency     UrgencyLevel
  status      RequestStatus @default(PENDING)
  imageUrl    String?       @map("image_url")
  adminComment String?       @map("admin_comment")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  resolvedAt  DateTime?     @map("resolved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("maintenance_requests")
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(STUDENT)
  deviceToken  String?  @map("device_token")
  addressId    Int?     @map("address_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  address             Address?             @relation(fields: [addressId], references: [id])
  userMealPlans       UserMealPlan[]
  choreAssignments    ChoreAssignment[]
  budgets             Budget[]
  expenses            Expense[]
  bills               Bill[]
  billSharing         BillSharing[]
  schedules           Schedule[]
  maintenanceRequests MaintenanceRequest[]
  profile      Profile?

  @@index([email])
  @@map("users")
}

model Profile {
  id          Int     @id @default(autoincrement())
  studentId   String  @unique @map("student_id") 
  roomNumber  String? @map("room_number")
  avatarUrl   String? @map("avatar_url")
  
  // Relation to User
  userId      Int     @unique @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

//Enums
enum UserRole {
  STUDENT @map("student")
  STAFF   @map("staff")
  ADMIN   @map("admin")
}

enum MealType {
  BREAKFAST @map("breakfast")
  LUNCH     @map("lunch")
  DINNER    @map("dinner")
}

enum UrgencyLevel {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
}

enum RequestStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  RESOLVED    @map("resolved")
}

enum BillStatus {
  UNPAID         @map("Unpaid")
  PARTIALLY_PAID @map("Partially Paid")
  PAID           @map("Paid")
}

enum ReminderMethod {
  EMAIL        @map("Email")
  NOTIFICATION @map("Notification")
}

enum ScheduleType {
  WORK     @map("work")
  CLASS    @map("class")
  PERSONAL @map("personal")
}

enum DietaryRestriction {
  GLUTEN_FREE @map("gluten_free")
  DAIRY_FREE  @map("dairy_free")
  VEGETARIAN  @map("vegetarian")
  NUT_FREE    @map("nut_free")
  HALAL       @map("halal")
  KOSHER      @map("kosher")
}

enum ExpenseCategory {
  FOOD           @map("food")
  UTILITIES      @map("utilities")
  ENTERTAINMENT  @map("entertainment")
  SUPPLIES       @map("supplies")
  TRANSPORTATION @map("transportation")
  EDUCATION      @map("education")
  HEALTHCARE     @map("healthcare")
  OTHER          @map("other")
}

enum ChoreStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  OVERDUE   @map("overdue")
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

