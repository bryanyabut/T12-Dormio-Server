generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Address {
  id         Int     @id @default(autoincrement())
  street     String?
  city       String?
  province   String?
  country    String?
  postalCode String?
  unitNumber String?
  users      User[]
}

model bill_reminders {
  id              Int              @id @default(autoincrement())
  bill_share_id   Int
  reminder_date   DateTime?        @db.Date
  reminder_method reminder_method?
  bill_shares     bill_shares      @relation(fields: [bill_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bill_share_links {
  bill_id       Int
  bill_share_id Int
  bills         bills       @relation(fields: [bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bill_shares   bill_shares @relation(fields: [bill_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([bill_id, bill_share_id])
}

model bill_shares {
  id               Int                @id @default(autoincrement())
  sharing_amount   Decimal?           @db.Decimal(15, 2)
  paid             Boolean            @default(false)
  reminder_count   Int                @default(0)
  bill_reminders   bill_reminders[]
  bill_share_links bill_share_links[]
  user_bill_shares user_bill_shares[]
}

model bills {
  id               Int                @id @default(autoincrement())
  user_id          Int
  meal_plan_id     Int?
  title            String?
  amount           Decimal?           @db.Decimal(15, 2)
  due_date         DateTime?          @db.Date
  status           bill_status        @default(Unpaid)
  date_created     DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  bill_share_links bill_share_links[]
  meal_plans       meal_plans?        @relation(fields: [meal_plan_id], references: [id], onUpdate: NoAction)
  users            users              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model budget_expenses {
  budget_id  Int
  expense_id Int
  budgets    budgets  @relation(fields: [budget_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenses   expenses @relation(fields: [expense_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([budget_id, expense_id])
}

model budgets {
  id              Int               @id @default(autoincrement())
  user_id         Int
  meal_plan_id    Int?
  month_date      DateTime?         @db.Date
  week_date       DateTime?         @db.Date
  total_budget    Decimal?          @db.Decimal(15, 2)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  budget_expenses budget_expenses[]
  meal_plans      meal_plans?       @relation(fields: [meal_plan_id], references: [id], onUpdate: NoAction)
  users           users             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calendar {
  id          Int                   @id @default(autoincrement())
  user_id     Int
  start_at    DateTime?             @db.Timestamptz(6)
  end_at      DateTime?             @db.Timestamptz(6)
  all_day     Boolean               @default(false)
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @default(now()) @db.Timestamptz(6)
  source_type calendar_source_type?
  source_id   Int?
  users       users                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([source_type, source_id], map: "idx_calendar_source")
  @@index([user_id], map: "idx_calendar_user_id")
}

model chore_assignment_items {
  chore_id            Int
  chore_assignment_id Int
  chore_assignments   chore_assignments @relation(fields: [chore_assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chores              chores            @relation(fields: [chore_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([chore_id, chore_assignment_id])
}

model chore_assignments {
  id                     Int                      @id @default(autoincrement())
  user_id                Int
  due_at                 DateTime?                @db.Timestamptz(6)
  status                 String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  chore_assignment_items chore_assignment_items[]
  users                  users                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model chores {
  id                     Int                      @id @default(autoincrement())
  chore_name             String?
  description            String?
  chore_assignment_items chore_assignment_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model class_schedules {
  id            Int         @id @default(autoincrement())
  user_id       Int
  meal_plan_id  Int?
  class_name    String?
  class_date    DateTime?   @db.Date
  start_time    DateTime?   @db.Time(6)
  end_time      DateTime?   @db.Time(6)
  class_section String?
  class_code    String?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  meal_plans    meal_plans? @relation(fields: [meal_plan_id], references: [id], onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model expenses {
  id              Int               @id @default(autoincrement())
  category        String?
  amount          Decimal?          @db.Decimal(15, 2)
  date_created    DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_expenses  Decimal?          @db.Decimal(15, 2)
  budget_expenses budget_expenses[]
}

model Ingredient {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  dietaryRestriction  DietaryRestriction?
  mealItemIngredients MealItemIngredient[]
}

//Junction table
model MealItemIngredient {
  id           Int     @id @default(autoincrement())
  mealItemId   Int
  ingredientId Int

  mealItem   MealItem   @relation(fields: [mealItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([mealItemId, ingredientId])
}

model MealItem {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  category            MealType?
  createdAt           DateTime             @default(now())
  mealPlans           MealPlan[]
  mealItemIngredients MealItemIngredient[]
}

model MealPlan {
  id         Int      @id @default(autoincrement())
  userId     Int
  mealItemId Int
  mealDate   DateTime @db.Date
  mealType   MealType
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItem MealItem @relation(fields: [mealItemId], references: [id])

  @@index([userId, mealDate])
}

model maintenance_requests {
  id          Int      @id @default(autoincrement())
  user_id     Int
  title       String?
  description String?
  status      String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_maintenance_requests_user_id")
}

model user_bill_shares {
  user_id       Int
  bill_share_id Int
  bill_shares   bill_shares @relation(fields: [bill_share_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, bill_share_id])
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  addressId    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  address             Address?             @relation(fields: [addressId], references: [id])
  mealPlans           MealPlan[]
  choreAssignments    ChoreAssignment[]
  budgets             Budget[]
  expenses            Expense[]
  bills               Bill[]
  billSharing         BillSharing[]
  schedules           Schedule[]
  maintenanceRequests MaintenanceRequest[]

  @@index([email])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model work_shifts {
  id         Int       @id @default(autoincrement())
  job_name   String?
  date_start DateTime? @db.Timestamptz(6)
  date_end   DateTime? @db.Timestamptz(6)
  users      users[]
}

//Enums
enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ReminderMethod {
  EMAIL
  NOTIFICATION
}

enum ScheduleType {
  WORK
  CLASS
  PERSONAL
}

enum DietaryRestriction {
  GLUTEN_FREE
  DAIRY_FREE
  VEGETARIAN
  NUT_FREE
  HALAL
  KOSHER
}

enum ExpenseCategory {
  FOOD
  UTILITIES
  ENTERTAINMENT
  SUPPLIES
  TRANSPORTATION
  EDUCATION
  HEALTHCARE
  OTHER
}

enum ChoreStatus {
  PENDING
  COMPLETED
  OVERDUE
}